# Required: Google PageSpeed Insights API key (free, 25,000 queries/day)
# Get yours at: https://console.cloud.google.com/apis/credentials
# Enable "PageSpeed Insights API" first
VITE_GOOGLE_API_KEY=your_api_key_here

# Optional: Form endpoint for lead capture (Formspree, Getform, etc.)
# Without this, form submissions open a mailto: link instead
# VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
